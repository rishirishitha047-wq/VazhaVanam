# Copy this file to .env and fill in your values.
# Never commit .env to git. Never paste real keys in chat.

# AWS credentials (preferred: use aws configure or aws sso login instead)
# AWS_ACCESS_KEY_ID=your-access-key-id-here
# AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION=us-east-1

# Bedrock model (default works, change only if you have a different model enabled)
SHIP_MODEL=us.amazon.nova-2-lite-v1:0

# Session storage directory (created automatically)
VAZHAVANAM_SESSIONS=~/.vazhavanam-sessions